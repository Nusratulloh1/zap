// ZAP! backend — деньги ТОЛЬКО integer UZS, телефоны нормализованы 998XXXXXXXXX.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  name         String   @default("")
  handle       String?  @unique
  avatarUrl    String?
  pinHash      String?
  pinFailCount Int      @default(0)
  pinLockedTil DateTime?
  /** язык интерфейса: uz | ru | en — следует за аккаунтом между устройствами
      и пригодится для локализации SMS */
  locale       String   @default("uz")
  createdAt    DateTime @default(now())

  cards          Card[]
  contacts       Contact[]      @relation("owner")
  refreshTokens  RefreshToken[]
  splitsCreated  Split[]
  cashback       CashbackEntry[]
  historyEvents  HistoryEvent[]
  transactions   Transaction[]
  debtsAsCreditor Debt[]        @relation("creditor")
  debtsAsDebtor   Debt[]        @relation("debtor")
  groupsOwned     Group[]
}

enum OtpPurpose {
  login
  participant_pay
}

model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose @default(login)
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, createdAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  deviceInfo String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// одноразовые payment-токены: jti помечается использованным
model ConsumedJti {
  jti       String   @id
  createdAt DateTime @default(now())
}

model IdempotencyKey {
  key       String   @id
  userId    String
  response  Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum CardBrand {
  UZCARD
  HUMO
}

model Card {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     CardBrand
  last4     String
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Contact {
  id           String  @id @default(cuid())
  ownerId      String
  owner        User    @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  phone        String
  name         String
  linkedUserId String?
  createdAt    DateTime @default(now())

  @@unique([ownerId, phone])
  @@index([ownerId])
}

model Merchant {
  id                 String  @id @default(cuid())
  name               String
  letter             String  @default("M")
  color              String  @default("#111110")
  logoUrl            String?
  cashbackRate       Int     @default(25) // промилле·10: 25 = 2.5%
  cashbackX2         Boolean @default(false)
  cashbackConditions Json?

  bills    Bill[]
  splits   Split[]
  cashback CashbackEntry[]
}

model Bill {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  externalRef String
  tableRef    String?
  totalAmount Int
  qrPayload   String   @unique
  createdAt   DateTime @default(now())

  items  BillItem[]
  splits Split[]
}

model BillItem {
  id     String @id @default(cuid())
  billId String
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  title  String
  qty    Int    @default(1)
  amount Int

  assignments ItemAssignment[]
}

enum SplitMode {
  equal
  manual
  items
}

enum SplitStatus {
  active
  closed
  cancelled
}

model Split {
  id          String      @id @default(cuid())
  code        String      @unique
  creatorId   String
  creator     User        @relation(fields: [creatorId], references: [id])
  billId      String?
  bill        Bill?       @relation(fields: [billId], references: [id])
  merchantId  String?
  merchant    Merchant?   @relation(fields: [merchantId], references: [id])
  title       String
  totalAmount Int
  mode        SplitMode
  status      SplitStatus @default(active)
  groupId     String?
  group       Group?      @relation(fields: [groupId], references: [id])
  cashback    Int?
  cashbackX2  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  closedAt    DateTime?

  members SplitMember[]
  debts   Debt[]

  @@index([creatorId, createdAt])
}

enum MemberStatus {
  pending
  opened
  paid
  covered
  debt
}

model SplitMember {
  id          String       @id @default(cuid())
  splitId     String
  split       Split        @relation(fields: [splitId], references: [id], onDelete: Cascade)
  userId      String?
  phone       String
  displayName String
  shareAmount Int
  status      MemberStatus @default(pending)
  isCreator   Boolean      @default(false)
  paidAmount  Int          @default(0)
  lastRemindedAt DateTime?
  paidAt      DateTime?
  coveredById String?

  assignments ItemAssignment[]

  @@unique([splitId, phone])
  @@index([phone])
}

model ItemAssignment {
  splitMemberId String
  member        SplitMember @relation(fields: [splitMemberId], references: [id], onDelete: Cascade)
  billItemId    String
  item          BillItem    @relation(fields: [billItemId], references: [id], onDelete: Cascade)
  qtyShare      Int         @default(1)

  @@id([splitMemberId, billItemId])
}

model Group {
  id                 String   @id @default(cuid())
  name               String
  ownerId            String
  owner              User     @relation(fields: [ownerId], references: [id])
  cashbackPoolEnabled Boolean @default(true)
  cashbackPool       Int      @default(0)
  createdAt          DateTime @default(now())

  members GroupMember[]
  splits  Split[]
}

model GroupMember {
  id      String  @id @default(cuid())
  groupId String
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String?
  phone   String
  name    String
  role    String  @default("member")

  @@unique([groupId, phone])
}

enum DebtStatus {
  open
  settled
}

model Debt {
  id             String     @id @default(cuid())
  creditorId     String
  creditor       User       @relation("creditor", fields: [creditorId], references: [id])
  debtorUserId   String?
  debtor         User?      @relation("debtor", fields: [debtorUserId], references: [id])
  debtorPhone    String
  debtorName     String     @default("")
  splitId        String?
  split          Split?     @relation(fields: [splitId], references: [id])
  amount         Int
  reason         String     @default("")
  status         DebtStatus @default(open)
  settledAt      DateTime?
  lastRemindedAt DateTime?
  createdAt      DateTime   @default(now())

  releasedCashback CashbackEntry[]

  @@index([creditorId, status])
  @@index([debtorPhone])
}

enum CashbackStatus {
  available
  held_debt
  spent
  withdrawn
}

model CashbackEntry {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  splitId          String?
  merchantId       String?
  merchant         Merchant?      @relation(fields: [merchantId], references: [id])
  amount           Int
  multiplier       Int            @default(1)
  status           CashbackStatus @default(available)
  releasedByDebtId String?
  releasedByDebt   Debt?          @relation(fields: [releasedByDebtId], references: [id])
  title            String         @default("")
  badge            String         @default("")
  groupId          String?
  createdAt        DateTime       @default(now())

  @@index([userId, createdAt])
}

model HistoryEvent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  refId        String?
  amountSigned Int
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

enum SmsKind {
  otp
  split_link
  reminder
  partner_lead
}

model SmsLog {
  id                String   @id @default(cuid())
  phone             String
  kind              SmsKind
  providerMessageId String?
  status            String
  error             String?
  createdAt         DateTime @default(now())

  @@index([phone, createdAt])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int // + пополнение / − списание
  kind      String // charge | payout
  ref       String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// пер-юзерные настройки (мобильный клиент)
model UserSettings {
  userId            String  @id
  debtNotifications Boolean @default(true)
  promoDismissed    Boolean @default(false)
  visits            Int     @default(0)
  pendingCashback   Int     @default(0)
}

/// Фискальный чек: распарсенная страница ОФД или OCR-фолбэк.
model FiscalReceipt {
  id              String   @id @default(cuid())
  userId          String
  fiscalKey       String   @unique // дедуп: одинаковый чек не парсим дважды
  url             String
  status          String   @default("pending") // pending | ready | failed_parse
  source          String   @default("page") // page | ocr
  merchantName    String?
  merchantInn     String?
  receiptDatetime DateTime?
  totalAmount     Int?
  snapshotFile    String?
  createdAt       DateTime @default(now())

  items FiscalReceiptItem[]

  @@index([userId, createdAt])
}

model FiscalReceiptItem {
  id        String        @id @default(cuid())
  receiptId String
  receipt   FiscalReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  name      String
  qtyMilli  Int           @default(1000) // 0.500 кг → 500
  unitPrice Int
  lineTotal Int
}

/// счётчики фискального инжеста (метрики /health + алерт)
model FiscalEvent {
  id        String   @id @default(cuid())
  kind      String // fiscal_resolved | parse_ok | parse_failed | ocr_used
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

/// Заявка партнёра с лендинга (ресторан/магазин хочет подключиться).
model PartnerLead {
  id        String   @id @default(cuid())
  company   String
  contact   String
  phone     String
  city      String?
  message   String?
  source    String   @default("landing")
  status    String   @default("new") // new | contacted | closed
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}
