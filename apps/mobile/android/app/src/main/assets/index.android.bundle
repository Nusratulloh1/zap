441\u0430\u043c.",step2Label:"02 \xb7 \u0427\u0415\u041a",step2Title:"\u041e\u0434\u0438\u043d \u0447\u0435\u043a \u043d\u0430 \u0442\u0440\u043e\u0438\u0445.",step2Text:"ZAP! \u0432\u0438\u0434\u0438\u0442 \u0441\u0430\u043c \u0441\u0447\u0451\u0442: \u0447\u0442\u043e \u0437\u0430\u043a\u0430\u0437\u0430\u043b\u0438, \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u0442\u043e\u0438\u0442, \u043a\u0442\u043e \u0447\u0442\u043e \u0432\u0437\u044f\u043b.",step3Label:"03 \xb7 \u0414\u0415\u041b\u0415\u041d\u0418\u0415",step3Title:"\u0421\u0447\u0451\u0442 \u0434\u0435\u043b\u0438\u0442\u0441\u044f \u043c\u0435\u0436\u0434\u0443 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438.",step3Text:"\u041f\u043e\u0440\u043e\u0432\u043d\u0443, \u043f\u043e \u043f\u043e\u0437\u0438\u0446\u0438\u044f\u043c \u0438\u043b\u0438 \u043a\u0430\u043a \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438\u0441\u044c. \u0414\u0435\u0441\u044f\u0442\u044c \u0441\u0435\u043a\u0443\u043d\u0434 \u2014 \u0438 \u0443 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0441\u0432\u043e\u044f \u0434\u043e\u043b\u044f.",step4Label:"04 \xb7 \u0414\u041e\u041b\u0418",step4Title:"\u041d\u0438\u043a\u0442\u043e \u043d\u0435 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u0434\u043e\u043b\u0436\u0435\u043d \u0432 \u0443\u043c\u0435.",step4Text:"\u0423 \u043a\u043e\u0433\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u043d\u0435\u0442 \u0434\u0435\u043d\u0435\u0433 \u2014 \u0431\u0435\u0440\u0451\u0442 \u0432 \u0434\u043e\u043b\u0433 \u043f\u0440\u044f\u043c\u043e \u0432 ZAP!. \u0422\u044b \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u0435\u0448\u044c \u0434\u043e\u043b\u044e, \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u043c\u043d\u0438\u0442 \u0438 \u0437\u0430\u043a\u0440\u043e\u0435\u0442 \u0435\u0451 \u0441\u0430\u043c\u043e.",step5Label:"05 \xb7 \u0421\u0421\u042b\u041b\u041a\u0410",step5Title:"\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043d\u0443\u0436\u043d\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0435\u0431\u0435.",step5Text:"\u0414\u0440\u0443\u0437\u044c\u044f \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442 \u0441\u0441\u044b\u043b\u043a\u0443 \u0432 SMS \u0438 \u043f\u043b\u0430\u0442\u044f\u0442 \u043f\u0440\u044f\u043c\u043e \u0438\u0437 \u043d\u0435\u0451. \u0411\u0435\u0437 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438.",step6Label:"06 \xb7 \u0423\u0427\u0410\u0421\u0422\u041d\u0418\u041a",step6Title:"\u0414\u0440\u0443\u0433 \u043f\u043b\u0430\u0442\u0438\u0442 \u0437\u0430 \u0434\u0432\u0435 \u0441\u0435\u043a\u0443\u043d\u0434\u044b.",step6Text:"\u041e\u0442\u043a\u0440\u044b\u043b \u0441\u0441\u044b\u043b\u043a\u0443, \u0443\u0432\u0438\u0434\u0435\u043b \u0441\u0432\u043e\u044e \u0434\u043e\u043b\u044e, \u043e\u043f\u043b\u0430\u0442\u0438\u043b \u043a\u0430\u0440\u0442\u043e\u0439. \u041d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u043b.",step7Label:"07 \xb7 \u0421\u0422\u0410\u0422\u0423\u0421",step7Title:"\u0412\u0438\u0434\u043d\u043e \u0432\u0441\u0451 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438.",step7Text:"\u041a\u0442\u043e \u043e\u043f\u043b\u0430\u0442\u0438\u043b, \u043a\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u043b, \u043a\u043e\u043c\u0443 \u043d\u0430\u043f\u043e\u043c\u043d\u0438\u0442\u044c.",step8Label:"08 \xb7 \u041a\u042d\u0428\u0411\u042d\u041a",step8Title:"\u041a\u044d\u0448\u0431\u044d\u043a \xd72 \u0432\u0441\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u0435.",step8Text:"\u041f\u043b\u0430\u0442\u0438\u043b\u0438 \u0432\u043c\u0435\u0441\u0442\u0435 \u2014 \u0431\u043e\u043d\u0443\u0441 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u043a\u0430\u0436\u0434\u044b\u0439.",marquee:"\u0421\u041a\u0410\u041d \xb7 \u0414\u0415\u041b\u0418 \xb7 \u0421\u0421\u042b\u041b\u041a\u0410 \xb7 \u041a\u042d\u0428\u0411\u042d\u041a \xd72 \xb7 \u0411\u0415\u0417 \u0423\u0421\u0422\u0410\u041d\u041e\u0412\u041a\u0418 \xb7 PAYME \xb7 CLICK \xb7 UZCARD \xb7 HUMO \xb7 ",reasonsTitle:"\u0427\u0435\u0442\u044b\u0440\u0435 \u043f\u0440\u0438\u0447\u0438\u043d\u044b, \u043f\u043e \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u044d\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442.",reason1Title:"\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u2014 \u0442\u043e\u043b\u044c\u043a\u043e \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u043e\u0440\u0443.",reason1Text:"\u0423\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0438 \u043f\u043b\u0430\u0442\u044f\u0442 \u043f\u043e \u0441\u0441\u044b\u043b\u043a\u0435 \u0438\u0437 SMS. \u0411\u0430\u0440\u044c\u0435\u0440 \u0432\u0445\u043e\u0434\u0430 \u043d\u0443\u043b\u0435\u0432\u043e\u0439.",reason2Title:"\u0414\u043e\u043b\u0433\u0438 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0441\u0430\u043c\u0438.",reason2Text:"\u0412\u0437\u044f\u043b \u0432 \u0434\u043e\u043b\u0433 \u2014 ZAP! \u043f\u043e\u043c\u043d\u0438\u0442 \u0438 \u0441\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u043f\u0440\u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0442\u0435. \u041d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0442\u044c \u043d\u0435 \u043d\u0443\u0436\u043d\u043e.",reason3Title:"\u041b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u0440\u0435\u043b\u044c\u0441\u044b.",reason3Text:"Payme, Click, \u043a\u0430\u0440\u0442\u044b Uzcard \u0438 Humo. \u0412\u0441\u0451, \u0447\u0435\u043c \u0443\u0436\u0435 \u043f\u043b\u0430\u0442\u044f\u0442 \u0432 \u0423\u0437\u0431\u0435\u043a\u0438\u0441\u0442\u0430\u043d\u0435.",reason4Title:"\u041a\u044d\u0448\u0431\u044d\u043a \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0430 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044e.",reason4Text:"\u0411\u043e\u043d\u0443\u0441 \u043d\u0430\u0447\u0438\u0441\u043b\u044f\u0435\u0442\u0441\u044f, \u043a\u043e\u0433\u0434\u0430 \u0441\u043f\u043b\u0438\u0442\u0438\u0442\u0435 \u0432\u043c\u0435\u0441\u0442\u0435. \u041e\u0434\u0438\u043d \u2014 \u043d\u0435 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f.",stripTitle:"\u041a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u0432\u044b\u0431\u0438\u0440\u0430\u044e\u0442, \u043a\u0443\u0434\u0430 \u043f\u043e\u0439\u0442\u0438.",stripTitleAccent:"ZAP! \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0433\u0434\u0435 \u0432\u044b\u0433\u043e\u0434\u043d\u0435\u0435.",stripSub:"\u0417\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f-\u043f\u0430\u0440\u0442\u043d\u0451\u0440\u044b \u0441\u0430\u043c\u0438 \u043e\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u044e\u0442 \u043f\u0440\u043e\u043c\u043e \u2014 \u0432\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0435 \u0431\u043e\u043b\u044c\u0448\u0435 \u0437\u0430 \u0442\u043e\u0442 \u0436\u0435 \u0447\u0435\u043a.",card1Sub:"\u043f\u0438\u0446\u0446\u0430 \xb7 \u0422\u0430\u0448\u043a\u0435\u043d\u0442",card1Badge:"\u041a\u042d\u0428\u0411\u042d\u041a \xd72 \xb7 \u041f\u041d-\u0427\u0422 \xb7 \u0412\u0421\u0415\u0419 \u0413\u0420\u0423\u041f\u041f\u041e\u0419",card2Sub:"\u0444\u0430\u0441\u0442\u0444\u0443\u0434 \xb7 \u0441\u0435\u0442\u044c",card2Badge:"\u041e\u0422 3 \u0427\u0415\u041b\u041e\u0412\u0415\u041a",card3Sub:"\u0443\u0437\u0431\u0435\u043a\u0441\u043a\u0430\u044f \u043a\u0443\u0445\u043d\u044f",card3Badge:"\u041a\u042d\u0428\u0411\u042d\u041a \xd72 \xb7 \u0412\u0415\u0421\u042c \u0414\u0415\u041d\u042c",card4Sub:"\u043f\u0435\u043a\u0430\u0440\u043d\u044f \xb7 \u043a\u043e\u0444\u0435",card4Badge:"\u0414\u041e 30 \u0421\u0415\u041d \xb7 \u041e\u0422 3 \u0427\u0415\u041b\u041e\u0412\u0415\u041a",card5Sub:"\u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0438 \u0437\u0430\u043b",card5Badge:"\u041e\u0422 2 \u0427\u0415\u041b\u041e\u0412\u0415\u041a",merchKicker:"\u0434\u043b\u044f \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0439",merchTitle:"\u0413\u0440\u0443\u043f\u043f\u043e\u0432\u043e\u0439 \u0442\u0440\u0430\u0444\u0438\u043a, \u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u044b \u043f\u043b\u0430\u0442\u0438\u0442\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e \u0444\u0430\u043a\u0442\u0443.",merchFeeText:"\u043a\u043e\u043c\u0438\u0441\u0441\u0438\u044f \u0441 \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441\u043f\u043b\u0438\u0442\u0430. \u0410\u0431\u043e\u043d\u0435\u043d\u0442\u0441\u043a\u043e\u0439 \u043f\u043b\u0430\u0442\u044b \u043d\u0435\u0442.",merchKit:"QR-\u041a\u041e\u041c\u041f\u041b\u0415\u041a\u0422",merchKitText:"\u0442\u0435\u0439\u0431\u043b-\u0442\u0435\u043d\u0442\u044b \u0438 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438. \u0418\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044f \u0441 \u043a\u0430\u0441\u0441\u043e\u0439 \u043d\u0435 \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u0430.",merchCab:"\u041a\u0410\u0411\u0418\u041d\u0415\u0422",merchCabText:"\u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u0433\u0440\u0443\u043f\u043f\u043e\u0432\u044b\u0445 \u0432\u0438\u0437\u0438\u0442\u043e\u0432 \u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0442\u043e\u0432 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0439.",merchCta:"\u0421\u0442\u0430\u0442\u044c \u043f\u0430\u0440\u0442\u043d\u0451\u0440\u043e\u043c",dashVisits:"\u0413\u0420\u0423\u041f\u041f\u041e\u0412\u042b\u0415 \u0412\u0418\u0417\u0418\u0422\u042b",dashDays:"30 \u0414\u041d\u0415\u0419",dashK1:"\u0432\u0438\u0437\u0438\u0442\u043e\u0432 \u0433\u0440\u0443\u043f\u043f\u0430\u043c\u0438",dashK2:"\u0441\u0440\u0435\u0434\u043d\u0438\u0439 \u0447\u0435\u043a, \u0441\u0443\u043c",faqTitle:"\u0412\u043e\u043f\u0440\u043e\u0441\u044b.",q1:"\u041d\u0443\u0436\u043d\u043e \u043b\u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0432\u0441\u0435\u043c \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0430\u043c?",a1:"\u041d\u0435\u0442. \u0422\u043e\u043b\u044c\u043a\u043e \u0442\u043e\u043c\u0443, \u043a\u0442\u043e \u0434\u0435\u043b\u0438\u0442 \u0441\u0447\u0451\u0442. \u041e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u043b\u0430\u0442\u044f\u0442 \u043f\u043e \u0441\u0441\u044b\u043b\u043a\u0435 \u0438\u0437 SMS.",q2:"\u0427\u0435\u043c \u043f\u043b\u0430\u0442\u044f\u0442 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0438?",a2:"Payme, Click \u0438\u043b\u0438 \u043a\u0430\u0440\u0442\u043e\u0439 Uzcard/Humo \u043f\u0440\u044f\u043c\u043e \u0441\u043e \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u043f\u043e \u0441\u0441\u044b\u043b\u043a\u0435.",q3:"\u0427\u0442\u043e \u0437\u043d\u0430\u0447\u0438\u0442 \xab\u0432 \u0434\u043e\u043b\u0433\xbb?",a3:"\u0412\u044b \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0435 \u0447\u0443\u0436\u0443\u044e \u0434\u043e\u043b\u044e, ZAP! \u0437\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442 \u0438 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0435\u0451 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438, \u043a\u043e\u0433\u0434\u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0432\u0435\u0440\u043d\u0451\u0442 \u0434\u0435\u043d\u044c\u0433\u0438.",q4:"\u041a\u0430\u043a \u043d\u0430\u0447\u0438\u0441\u043b\u044f\u0435\u0442\u0441\u044f \u043a\u044d\u0448\u0431\u044d\u043a \xd72?",a4:"\u0417\u0430 \u0441\u043f\u043b\u0438\u0442\u044b \u0432 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f\u0445-\u043f\u0430\u0440\u0442\u043d\u0451\u0440\u0430\u0445, \u043a\u043e\u0433\u0434\u0430 \u043f\u043b\u0430\u0442\u0438\u0442\u0435 \u0433\u0440\u0443\u043f\u043f\u043e\u0439 \u043e\u0442 \u0434\u0432\u0443\u0445 \u0447\u0435\u043b\u043e\u0432\u0435\u043a. \u0411\u043e\u043d\u0443\u0441 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u043a\u0430\u0436\u0434\u044b\u0439 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a.",q5:"\u0421\u043a\u043e\u043b\u044c\u043a\u043e \u044d\u0442\u04