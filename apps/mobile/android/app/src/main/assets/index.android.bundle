,rolls:"Rolls",sushi:"Sushi",doner:"Doner",bakery:"Bakery",croissants:"Croissants",coffee:"Coffee",desserts:"Desserts",supermarket:"Supermarket",tech:"Appliances",electronics:"Electronics",home:"Home goods",payments:"Payments",transfers:"Transfers"},badge:{promo:"Deal {v}",cashback:"Cashback {v}",discount:"Discount {v}",minutes:"{v} min"},offers:{b_evos:"second lavash free \u2014 until 30 September",b_oqtepa:"second lavash free when you split",b_maxway:"points cashback for the whole crew",b_lesailes:"when 4 or more of you split",b_bellissimo:"on the whole menu except drinks",b_sushitime:"on sets from 300 000 UZS",b_feedup:"third doner free on weekdays",b_bon:"on pastries before 12:00",b_safia:"when 3 or more of you split",b_korzinka:"on groceries every day",b_texnomart:"on appliances from 1M UZS",b_idea:"third item free",b_click:"cashback for paying via ZAP!",b_payme:"cashback for paying via ZAP!"},landing:{navHow:"how it works",navMerch:"for venues",navFaq:"questions",navDownload:"download",heroKicker:"bill splitting \xb7 tashkent",heroLine1:"Scan the receipt.",heroLine2:"Split the bill.",heroLine3Accent:"\xd72 cashback",heroLine3Rest:"for everyone.",heroSub:"One QR scan \u2014 and everyone pays their own share. Only one person needs the app.",ctaDownload:"Get ZAP!",ctaHow:"How it works",problemKicker:"how it goes today",problem1:"One person pays for everyone",problem2:"The rest will transfer later",problem3:"Transfers get lost, reminding is awkward",problemFinal:"ZAP! removes that conversation entirely.",step1Label:"01 \xb7 SCAN",step1Title:"Scan.",step1Text:"Point the camera at the QR on the receipt or at the till. The order loads by itself.",step2Label:"02 \xb7 RECEIPT",step2Title:"One receipt for three.",step2Text:"ZAP! reads the bill itself: what was ordered, what it costs, who took what.",step3Label:"03 \xb7 SPLIT",step3Title:"The bill splits between friends.",step3Text:"Equally, by item or however you agreed. Ten seconds \u2014 and everyone has their share.",step4Label:"04 \xb7 SHARES",step4Title:"Nobody ends up owing in their head.",step4Text:"Short on cash right now? Take the share on credit inside ZAP!. You cover it, the app remembers and closes it by itself.",step5Label:"05 \xb7 LINK",step5Title:"Only you need the app.",step5Text:"Friends get a link by SMS and pay straight from it. No install.",step6Label:"06 \xb7 PARTICIPANT",step6Title:"A friend pays in two seconds.",step6Text:"Opened the link, saw their share, paid by card. Installed nothing.",step7Label:"07 \xb7 STATUS",step7Title:"Everything visible in real time.",step7Text:"Who paid, who opened, who needs a nudge.",step8Label:"08 \xb7 CASHBACK",step8Title:"\xd72 cashback for the whole group.",step8Text:"Paid together \u2014 everyone gets the bonus.",marquee:"SCAN \xb7 SPLIT \xb7 LINK \xb7 \xd72 CASHBACK \xb7 NO INSTALL \xb7 PAYME \xb7 CLICK \xb7 UZCARD \xb7 HUMO \xb7 ",reasonsTitle:"Four reasons this works.",reason1Title:"The app is for the initiator only.",reason1Text:"Participants pay from an SMS link. Zero barrier to entry.",reason2Title:"Debts close themselves.",reason2Text:"Took a share on credit \u2014 ZAP! remembers and settles it on repayment. No reminders needed.",reason3Title:"Local payment rails.",reason3Text:"Payme, Click, Uzcard and Humo cards. Everything Uzbekistan already pays with.",reason4Title:"Cashback only for groups.",reason4Text:"The bonus lands when you split together. Alone does not count.",stripTitle:"Groups pick where to go.",stripTitleAccent:"ZAP! shows where it pays off.",stripSub:"Partner venues fund the promos themselves \u2014 you simply get more for the same bill.",card1Sub:"pizza \xb7 Tashkent",card1Badge:"\xd72 CASHBACK \xb7 MON-THU \xb7 WHOLE GROUP",card2Sub:"fast food \xb7 chain",card2Badge:"FROM 3 PEOPLE",card3Sub:"uzbek cuisine",card3Badge:"\xd72 CASHBACK \xb7 ALL DAY",card4Sub:"bakery \xb7 coffee",card4Badge:"UNTIL SEP 30 \xb7 FROM 3 PEOPLE",card5Sub:"delivery and dine-in",card5Badge:"FROM 2 PEOPLE",merchKicker:"for venues",merchTitle:"Group traffic you only pay for when it happens.",merchFeeText:"commission on an actual split. No subscription fee.",merchKit:"QR KIT",merchKitText:"table tents and stickers. Till integration is optional.",merchCab:"DASHBOARD",merchCabText:"statistics on group visits and returning parties.",merchCta:"Become a partner",dashVisits:"GROUP VISITS",dashDays:"30 DAYS",dashK1:"group visits",dashK2:"average bill, UZS",faqTitle:"Questions.",q1:"Does everyone need the app?",a1:"No. Only the person splitting the bill. The rest pay from an SMS link.",q2:"How do participants pay?",a2:"Payme, Click or a Uzcard/Humo card, right from the linked page.",q3:"What does \xabon credit\xbb mean?",a3:"You cover someone else\u2019s share, ZAP! remembers it and closes it automatically once they pay you back.",q4:"How is \xd72 cashback calculated?",a4:"For splits at partner venues when you pay as a group of two or more. Every participant gets the bonus.",q5:"What does it cost me?",a5:"Nothing. The venue pays the commission.",q6:"Does it work outside Tashkent?",a6:"We are launching in Tashkent and expanding from there.",finalTitle:"The next dinner \u2014 with no money talk.",ctaIos:"Download for iOS",ctaAndroid:"Download for Android",site:"zapapp.uz",footProduct:"product",footMerch:"for venues",footContacts:"contacts",footPrivacy:"privacy policy",footCopy:"zapapp.uz \xb7 Tashkent",modalKicker:"PARTNER REQUEST",modalTitle:"Become a ZAP! partner",modalSub:"We reply within one business day. 3% commission on an actual split, no subscription fee.",phVenue:"Venue name",phCity:"City and address",modalSend:"Send request",modalSending:"Sending\u2026",modalDoneTitle:"Request sent.",modalDoneText:"We will call the number you gave and bring the QR kit.",modalFail:"Could not send the request",modalClose:"Close",altPhone:"ZAP! app screen",chartAria:"Group visits chart",phContact:"Your name"},review:{title:"Check the items",fromPhoto:"Check the items \u2014 read from a photo",fromReceipt:"Items from the receipt \u2014 fix anything that is off",untitled:"Untitled",addItem:"Add an item",matches:"Matches the receipt",diff:"Difference from the receipt: {sign}{amount}",continueWith:"Continue \xb7 {amount}",itemTitle:"Item",namePlaceholder:"Name",amountLabel:"AMOUNT, UZS"},events:{opened:"{name} opened the link",paid:"{name} paid {amount}",closed:"Split closed",cashback:"Cashback credited +{amount}"},name:{tooShort:"at least 3 characters",checking:"checking\u2026",free:"\u2713 available",taken:"taken or not allowed",hint:"friends will find you by it",welcome:"Nice to meet you, {name}!",saveFailed:"Could not save \u2014 try again",title:"Create your profile",subtitle:"A username so friends can find you on ZAP!",placeholder:"First and last name"},fiscalProbe:{stepA:"a) GET the receipt page",stepB:"b) POST JSON API (unsigned)",stepC:"c) POST no-cors (network vs CORS)",stepCNote:"mode=no-cors \u2014 the body is hidden but network reachability shows",stepD:"d) GET the JSON API with parameters",intro:"Open it on a phone with Uzbek internet. We check whether receipt data is reachable from the client and whether CORS is open.",linkLabel:"RECEIPT LINK (QR)",apiLabel:"API URL (from DevTools, if different)",running:"Checking\u2026",run:"Run the check",copy:"Copy the results"}}},979,[]);
