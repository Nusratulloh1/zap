# --- база ---
DATABASE_URL=postgresql://zap:zap@localhost:5432/zap

# --- JWT ---
JWT_SECRET=change-me-64-random-bytes
JWT_REFRESH_SECRET=change-me-too

# --- SMS (send.smsxabar.uz, broker-api, Basic auth) ---
# ВНИМАНИЕ: креды, засветившиеся в переписке, РОТИРУЙТЕ в кабинете smsxabar
# и держите ТОЛЬКО в .env (вне git).
SMS_SERVICE_URL=https://send.smsxabar.uz
SMS_SERVICE_USERNAME=
SMS_SERVICE_PASSWORD=
SMS_ORIGINATOR=3700
SMS_DRY_RUN=true

# --- прочее ---
PWA_ORIGIN=http://localhost:5173
PORT=3000
# dev-режим: /auth/otp/request возвращает devCode (НИКОГДА не включать в проде)
OTP_DEV_HOOK=false
# разрешает pnpm seed:demo (демо-мерчант Bellissimo). В проде держать false.
ALLOW_DEMO_SEED=false
