# ЛОКАЛЬНАЯ разработка — БЕЗ реальных секретов. Скопируйте в .env.development
# (pnpm dev:all делает это сам). Прод (.env на сервере) не трогается.
DATABASE_URL=postgresql://zap:zap@localhost:5433/zap
JWT_SECRET=dev-only-secret-not-for-prod
JWT_REFRESH_SECRET=dev-only-refresh-secret

# SMS: dry-run — коды в консоль + /dev/sms/latest. Реальные креды НЕ НУЖНЫ.
SMS_DRY_RUN=true

PWA_ORIGIN=http://localhost:5173
PORT=3202
OTP_DEV_HOOK=true
ALLOW_DEMO_SEED=true
NODE_ENV=development

# ОФД-хосты для фискальных QR (dev: + локальная фикстура :3299)
OFD_HOSTS=ofd.soliq.uz,localhost:3299
