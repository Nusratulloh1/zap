{
  "name": "zap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "build:backend": "pnpm --filter zap-backend build",
    "icons": "node scripts/generate-icons.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "dev:https": "node scripts/dev-https.mjs",
    "db:seed:demo": "node scripts/dev-run.mjs node scripts/seed-dev.mjs",
    "db:reset": "node scripts/dev-run.mjs npx prisma migrate reset --force --skip-seed && node scripts/dev-run.mjs node scripts/seed-dev.mjs",
    "db:studio": "node scripts/dev-run.mjs npx prisma studio",
    "dev:fiscal-fixture": "node scripts/fiscal-fixture.mjs",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1"
  }
}
